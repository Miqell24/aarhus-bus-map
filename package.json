{
  "name": "aarhus-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Aarhus public transport (Midttrafik buses, Aarhus Letbane) — Rejseplanen GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=8192 pipeline/build.mjs --all --tram all",
    "lines": "node --max-old-space-size=8192 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=8192 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8168"
  }
}
